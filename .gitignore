# =============================================================================
# Terraform
# =============================================================================
# Local .terraform directories
**/.terraform/*

# .tfstate files (state is stored remotely)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Override files (local dev overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock file (keep this if you want reproducible builds - remove this line if so)
# .terraform.lock.hcl

# Plan files
*.tfplan

# =============================================================================
# Python
# =============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# pytest
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# mypy
.mypy_cache/

# =============================================================================
# Build artifacts
# =============================================================================
# Lambda zip package generated by Terraform archive_file
dist/lambda_ingestion.zip

# =============================================================================
# IDE
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# Secrets / Environment
# =============================================================================
.env
.env.*
*.pem
*.key
